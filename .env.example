# Copy to .env before `docker compose up`. Compose refuses to start without the
# values marked REQUIRED, so this file is not optional in production.
#
# Keep the real .env off the repo (it is in .gitignore) and keep a copy of the
# secrets in a password manager. Losing POSTGRES_PASSWORD while the data volume
# survives means the database can no longer be opened.
#
#   chmod 600 .env

# --- secrets ---------------------------------------------------------------

# REQUIRED. At least 32 characters, and not a placeholder — the server checks.
#   openssl rand -base64 48
# Changing it logs every user out. That is the intended way to end all sessions.
JWT_SECRET=

# REQUIRED. The database password.
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# Password for the seeded 'admin' account, applied only on first run against an
# empty database. If left empty a random one is generated and printed once in
# the backend logs — see docs/RUNBOOK.md, "First deploy".
GBOS_ADMIN_PASSWORD=

# --- how the shop is reached -----------------------------------------------

# REQUIRED. The hostname the shop uses. A bare hostname makes Caddy fetch and
# renew a real certificate and redirect http to https by itself.
#
# DNS for this name must already point at this machine — the certificate is
# issued by a challenge to this address, and it will fail otherwise.
#
# To run without TLS (a laptop, or a first check before DNS is moved) set:
#   GBOS_DOMAIN=http://localhost
GBOS_DOMAIN=shop.example.com

# REQUIRED. Let's Encrypt mails this address when renewal starts failing. Use
# one somebody actually reads.
GBOS_TLS_EMAIL=

# REQUIRED. The exact origin the browser loads, scheme included. "*" is
# rejected in release mode. Normally https:// plus GBOS_DOMAIN.
CORS_ORIGIN=https://shop.example.com

# --- host ports ------------------------------------------------------------
#
# Only Caddy is published; the backend, the frontend and Postgres are reachable
# only from inside the compose network.
#
# Change these ONLY if something else on this machine already owns 80/443.
# Automatic certificates need the public 80 and 443: Let's Encrypt connects to
# those ports by name and will not follow a different one. If they are taken,
# either bind GBOS to a second IP with GBOS_BIND_ADDRESS, or put GBOS behind
# the proxy that already owns them rather than moving these.
# GBOS_HTTP_PORT=80
# GBOS_HTTPS_PORT=443
# GBOS_BIND_ADDRESS=0.0.0.0

# The private network the containers talk over. Pinned so TRUSTED_PROXIES can
# name it exactly. Change both together if it overlaps a network this machine
# already has — `docker network ls` then `docker network inspect` to check.
# GBOS_NETWORK_SUBNET=10.89.7.0/24

# --- application -----------------------------------------------------------

# Optional; these defaults are fine for a single-business install.
# POSTGRES_USER=gbos
# POSTGRES_DB=gbos

# debug | info | warn | error
LOG_LEVEL=info

# Sets the day boundary for reports and receipts. Wrong here means the evening's
# takings land in tomorrow's column.
TZ=Asia/Kolkata

# Proxies whose X-Forwarded-For header may be believed. Must match the compose
# network above: rate limiting keys on client IP, and if the backend cannot see
# past Caddy then every customer shares one login-attempt budget.
# TRUSTED_PROXIES=10.89.7.0/24

# --- backups ---------------------------------------------------------------
#
# scripts/backup.sh reads these. See docs/RUNBOOK.md, "Backups".

# Where nightly dumps are written on this machine.
# BACKUP_DIR=/var/backups/gbos

# How many days of dumps to keep, here and on the remote.
# RETAIN_DAYS=30

# An rclone remote to copy each dump to. A backup on the same disk as the
# database does not survive the failure it exists for, so set this.
#   rclone config          # once, to create the remote
#   BACKUP_REMOTE=b2:my-shop-backups/gbos
# BACKUP_REMOTE=
