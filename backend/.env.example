# Settings for running the backend directly (`make backend` / `go run ./cmd/server`).
#
# This file is for DEVELOPMENT. Production settings live in the repository root
# .env, which docker compose reads — see ../.env.example and docs/RUNBOOK.md.
#
# Copy to .env or export before `go run`. Local development (GIN_MODE=debug,
# the default) works with no settings at all: the server falls back to the
# Postgres that `make db-up` starts on port 5434.

SERVER_PORT=8080

# The PostgreSQL connection string. Required in release mode; in debug mode it
# defaults to the `make db-up` database.
# DATABASE_URL=postgres://gbos:gbos_dev_password@localhost:5434/gbos_dev?sslmode=disable

# Required when GIN_MODE is anything other than debug. Must be at least 32
# characters and must not be a placeholder — the server refuses to start
# otherwise. Generate one with:
#   openssl rand -base64 48
# JWT_SECRET=

# Required in release mode. "*" is rejected.
# CORS_ORIGIN=https://shop.example.com

# Comma-separated proxies whose X-Forwarded-For may be trusted. Leave unset
# when the server is exposed directly: rate limiting keys on client IP, and an
# untrusted forwarding header lets a caller rotate past the login limiter.
# In the compose stack this is the private network Caddy sits on.
# TRUSTED_PROXIES=127.0.0.1

# Sets the day boundary for reports. Without it everything is UTC, which moves
# an Indian shop's evening takings into the next day.
# TZ=Asia/Kolkata

# Password for the seeded 'admin' account, applied only on first run against an
# empty database. If unset, a random one is generated and printed once at
# startup.
# GBOS_ADMIN_PASSWORD=
